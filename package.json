{
  "name": "roudari",
  "private": true,
  "version": "0.1.0",
  "description": "Roudari – kalustonhallinta ja keikkasuunnittelu (sisäinen työkalu)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=America/New_York vitest run && TZ=Europe/Helsinki vitest run --coverage",
    "coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:tz",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-roudari",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-roudari \"vitest run --config vitest.emulator.config.ts\"",
    "seed:emu": "tsx scripts/seed-emulator.ts"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.5",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tabler/icons-react": "~3.52.0",
    "dayjs": "^1.11.23",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "~8.5.2",
    "temporal-polyfill": "1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.3",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "~7.0.2007",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
